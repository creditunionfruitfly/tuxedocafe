{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuxedo Cafe MIDI cues v1",
  "type": "object",
  "required": ["version", "soundfont", "cues"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "soundfont": { "type": "string", "pattern": "^audio/soundfont/[a-z0-9_]+\\.sf3$" },
    "cues": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "midi", "tempoBpm", "ppq", "bars", "beatsPerBar", "loopStart", "loopEnd", "gainDb", "voices", "liveChanges"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "midi": { "type": "string", "pattern": "^audio/cues/[a-z0-9_]+\\.mid$" },
          "tempoBpm": { "type": "number", "minimum": 40, "maximum": 180 },
          "ppq": { "type": "integer", "minimum": 1, "maximum": 32767 },
          "bars": { "type": "integer", "minimum": 1, "maximum": 128 },
          "beatsPerBar": { "const": 4 },
          "loopStart": { "type": "integer", "minimum": 0 },
          "loopEnd": { "type": "integer", "minimum": 1 },
          "gainDb": { "type": "number", "minimum": -60, "maximum": 0 },
          "voices": {
            "type": "object", "additionalProperties": false,
            "required": ["desktop", "phone", "low"],
            "properties": {
              "desktop": { "type": "integer", "minimum": 1, "maximum": 64 },
              "phone": { "type": "integer", "minimum": 1, "maximum": 32 },
              "low": { "type": "integer", "minimum": 1, "maximum": 24 }
            }
          },
          "liveChanges": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["event", "type", "channel", "value"],
              "properties": {
                "event": { "type": "string", "minLength": 1 },
                "type": { "const": "gain" },
                "channel": { "type": "integer", "minimum": 0, "maximum": 15 },
                "value": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
