{
  "name": "tuxedocafe",
  "private": true,
  "version": "0.0.0",
  "description": "Tuxedo Cafe: a cozy first-person cat café for the browser.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc && eslint . && vitest run && node tools/provenance/check-provenance.ts && node .github/scripts/gen-pr-template.mjs --check",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "assets": "node tools/art/build-assets.ts",
    "audio:check": "node tools/audio/audio-check.ts",
    "sim:economy": "node tools/engine/sim-economy.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
